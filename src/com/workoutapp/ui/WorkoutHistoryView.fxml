<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" minWidth="650" minHeight="500"
            fx:controller="com.workoutapp.ui.WorkoutHistoryController">

    <!-- LEFT: Logged workouts  -->
    <left>
        <VBox spacing="10" prefWidth="250">
            <padding>
                <Insets top="10" left="10" bottom="10" right="5"/>
            </padding>

            <Label text="Past Workouts" style="-fx-font-size: 16;"/>

            <!-- List of routines (name + #exercises) -->
            <ListView fx:id="eventListView" prefHeight="300" editable="true"/>

            <!-- Date and Time Fields -->
            <HBox spacing="5">
                <Label text="Date:"/>
                <TextField fx:id="dateField" maxWidth="100" HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Time:"/>
                <TextField fx:id="timeField" maxWidth="100"  HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox spacing="10">
                <Button fx:id="deleteEventButton" text="Delete"/>
                <Button fx:id="adjustDateTimeButton" text="Adjust Date/Time"/>
            </HBox>

            <Button fx:id="exitButton" text="Exit" maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- RIGHT: Exercises in selected routine -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" left="5" bottom="10" right="10"/>
            </padding>

            <Label fx:id="workoutTitleLabel" text="Workout Details" style="-fx-font-size: 16;"/>

            <!-- Exercises list -->
            <ListView fx:id="exerciseListView" prefHeight="300"/>

            <!-- Bottom-right buttons -->
            <HBox spacing="10">
                <Label text="Notes:"/>
                <TextField fx:id="notesField" HBox.hgrow="ALWAYS"/>
                <Button fx:id="saveNotesButton" text="Save Notes" style="-fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
