<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.workoutapp.controllers.MainController">

    <top>
        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 12;">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <VBox spacing="2" style="-fx-background-radius: 14; -fx-padding: 10 18 10 18;" styleClass="card-pane">
                <Label fx:id="activeProfileLabel" text="No profile" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
            </VBox>

            <Pane HBox.hgrow="ALWAYS"/>

            <Label text="Profile:"/>
            <ComboBox fx:id="profileDropDown" prefWidth="120"/>
            <Button text="🌙 Dark Mode" fx:id="themeToggleButton" style="-fx-padding: 8 12;"/>
            <Button text="Profile Settings" fx:id="profileSettingsButton"/>
        </HBox>
    </top>

    <center>
        <SplitPane>
            <items>
                <StackPane fx:id="contentPane" style="-fx-padding: 20;"/>
            </items>
        </SplitPane>
    </center>

</BorderPane>
