<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" minWidth="650" minHeight="500"
            fx:controller="com.workoutapp.controllers.WorkoutHistoryController">

    <!-- LEFT: Logged workouts  -->
    <left>
        <VBox spacing="10" prefWidth="250">
            <padding>
                <Insets top="10" left="10" bottom="10" right="5"/>
            </padding>

            <Label text="Past Workouts" style="-fx-font-size: 16;"/>

            <!-- List of routines (name + #exercises) -->
            <ListView fx:id="eventListView" prefHeight="300" editable="true"/>

            <!-- Date and Time Fields -->
            <HBox spacing="5">
                <Label text="Date:"/>
                <TextField fx:id="dateField" maxWidth="100" HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Time:"/>
                <TextField fx:id="timeField" maxWidth="100"  HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox spacing="10">
                <Button fx:id="deleteEventButton" text="Delete"/>
                <Button fx:id="adjustDateTimeButton" text="Adjust Date/Time"/>
            </HBox>

            <Button fx:id="exitButton" text="Exit" maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- RIGHT: Exercises in selected routine -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" left="5" bottom="10" right="10"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="prevMonthButton" text="←" />
                <Label fx:id="monthLabel" text="Month" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                <Button fx:id="nextMonthButton" text="→" />
            </HBox>

            <GridPane fx:id="calendarGrid" hgap="4" vgap="4" style="-fx-background-color: #f8fafc; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10;" />

            <Label fx:id="selectedDateLabel" text="Selected Date" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
            <ListView fx:id="selectedDateEventList" prefHeight="140"/>

            <Label fx:id="workoutTitleLabel" text="Workout Details" style="-fx-font-size: 16;"/>
            <ListView fx:id="exerciseListView" prefHeight="200"/>

            <HBox spacing="10">
                <Label text="Notes:"/>
                <TextField fx:id="notesField" HBox.hgrow="ALWAYS"/>
                <Button fx:id="saveNotesButton" text="Save Notes" style="-fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
