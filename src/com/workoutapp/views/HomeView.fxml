<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.workoutapp.controllers.HomeController" minWidth="650" minHeight="500"
            style="-fx-background-color: #0f172a;">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- LEFT SIDE: Dashboard Summary -->
    <left>
        <VBox spacing="16" prefWidth="360"
              style="-fx-background-color: #1e293b; -fx-border-color: #334155; -fx-border-radius: 12; -fx-background-radius: 12; -fx-border-width: 1;">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Workout Dashboard"
                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #e2e8f0;"
                   maxWidth="Infinity"/>

            <GridPane hgap="12" vgap="12"
                      style="-fx-background-color: #0f172a; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14; -fx-border-color: #334155; -fx-border-width: 1;">
                <Label text="Total Workouts" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: 600;"/>
                <Label fx:id="totalWorkoutsLabel" text="0" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #38bdf8;"/>

                <Label text="Total Exercises" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: 600;"/>
                <Label fx:id="totalExercisesLabel" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #38bdf8;"/>

                <Label text="Cardio Minutes" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: 600;"/>
                <Label fx:id="totalCardioMinutesLabel" text="0" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #38bdf8;"/>
            </GridPane>

            <VBox spacing="8"
                  style="-fx-background-color: #0f172a; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14; -fx-border-color: #334155; -fx-border-width: 1;">
                <Label text="Latest Session" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #e2e8f0;"/>
                <Label fx:id="latestWorkoutLabel" text="No sessions yet" style="-fx-text-fill: #cbd5e1; -fx-font-weight: 600; -fx-font-size: 13;"/>
                <Label fx:id="latestWorkoutDetailsLabel" text="Complete a workout to see details here."
                    wrapText="true" style="-fx-text-fill: #94a3b8; -fx-font-size: 12;"/>
            </VBox>
        </VBox>
    </left>

    <!-- RIGHT SIDE: Navigation Buttons + Recovery Suggestions -->
    <right>
        <VBox spacing="16" prefWidth="360"
              style="-fx-background-color: #1e293b; -fx-border-color: #334155; -fx-border-radius: 12; -fx-background-radius: 12; -fx-border-width: 1;">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Button fx:id="startWorkoutButton" text="Start Workout"
                maxWidth="Infinity"
                style="-fx-font-size: 13; -fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 16; -fx-cursor: hand;"/>

            <Button fx:id="historyButton" text="Workout History"
                maxWidth="Infinity"
                style="-fx-font-size: 13; -fx-background-color: #475569; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 16; -fx-cursor: hand;"/>

            <Button fx:id="routineEditorButton" text="Routine Editor"
                maxWidth="Infinity"
                style="-fx-font-size: 13; -fx-background-color: #0ea5e9; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 16; -fx-cursor: hand;"/>

            <Label text="Recovery Suggestions" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #e2e8f0;"/>
            <VBox fx:id="recoveryBox" spacing="12" style="-fx-background-color: #f5f5f5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14; -fx-border-color: #e0e0e0; -fx-border-width: 1;" VBox.vgrow="ALWAYS">
                <PieChart fx:id="recoveryChart" title="Muscle Volume" legendSide="RIGHT" prefHeight="280" style="-fx-background-color: #f5f5f5;"/>
                <TextArea fx:id="recoveryDetailsArea" editable="false" wrapText="true"
                      prefHeight="160" style="-fx-font-size: 11; -fx-control-inner-background: #f8f8f8; -fx-background-insets: 0; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #ddd; -fx-text-fill: #333333;"/>
            </VBox>
        </VBox>
    </right>

</BorderPane>