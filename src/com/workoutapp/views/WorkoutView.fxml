<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.workoutapp.controllers.WorkoutController"
            style="-fx-background-color: #0f172a;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <center>
        <VBox fx:id="vboxRoot" spacing="15" alignment="TOP_CENTER"
              style="-fx-background-color: #1e293b; -fx-border-color: #334155; -fx-border-radius: 12; -fx-background-radius: 12; -fx-border-width: 1;">
            <padding>
                <Insets top="18" left="18" right="18" bottom="18"/>
            </padding>

            <!-- Content placeholder: controller will populate this VBox -->
            <Label text="Workout Session" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #e2e8f0;"/>
        </VBox>
    </center>

    <bottom>
        <HBox fx:id="bottomNav" spacing="10" alignment="CENTER" style="-fx-padding: 12 20 20 20; -fx-background-color: transparent;"/>
    </bottom>

</BorderPane>
