<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.workoutapp.controllers.WorkoutController">

    <center>
        <VBox fx:id="vboxRoot" spacing="15" alignment="TOP_CENTER">
            <padding>
                <Insets top="20" left="20" right="20" bottom="20"/>
            </padding>

            <!-- Content placeholder: controller will populate this VBox -->
            <Label text="Workout View" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
        </VBox>
    </center>

    <bottom>
        <HBox fx:id="bottomNav" spacing="10" alignment="CENTER" style="-fx-padding: 12 20 20 20; -fx-background-color: transparent;"/>
    </bottom>

</BorderPane>
