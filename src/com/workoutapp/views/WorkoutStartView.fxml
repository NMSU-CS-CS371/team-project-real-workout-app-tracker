<?xml version="1.0" encoding="UTF-8"?>

<!-- WorkoutStartView.fxml -->
<!-- Defines the Workout Start/selection screen (WorkoutStartController). -->
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.workoutapp.controllers.WorkoutStartController"
      spacing="20" alignment="TOP_CENTER"
        style="-fx-background-color: #0f172a;">

    <padding>
        <Insets top="30" left="30" right="30" bottom="30"/>
    </padding>

    <VBox spacing="8" alignment="CENTER">
        <Label text="Start Workout"
                style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #e2e8f0;"/>

        <Label text="Double-click to start a workout routine, or start without one."
                style="-fx-font-size: 13; -fx-text-fill: #94a3b8;"/>
    </VBox>

        <VBox spacing="10" style="-fx-background-color: #1e293b; -fx-border-color: #334155; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 16; -fx-border-width: 1;">
                <Label text="Available Routines" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #e2e8f0;"/>
                <ListView fx:id="routineList" prefWidth="300" prefHeight="220" style="-fx-background-color: #0f172a; -fx-control-inner-background: #0f172a; -fx-text-fill: #e2e8f0; -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8;"/>
    </VBox>

    <Button fx:id="startScratchButton"
            text="Start Without Routine"
            maxWidth="Infinity" prefWidth="300"
            style="-fx-font-size: 13; -fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 16;"/>

    <Button fx:id="cancelButton"
            text="Cancel"
            maxWidth="Infinity" prefWidth="300"
            style="-fx-font-size: 13; -fx-background-color: #475569; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 16;"/>

</VBox>
