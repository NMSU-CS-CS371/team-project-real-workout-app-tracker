<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.workoutapp.controllers.ProgressReportController"
            minWidth="650" minHeight="500"
            style="-fx-background-color: #f5f7fb;">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="16" right="16" bottom="12" left="16"/>
            </padding>
            <Button fx:id="backButton" text="Back"/>
            <Label fx:id="titleLabel" text="Progress Report" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
            <Pane HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <ScrollPane style="-fx-fit-to-width: true;">
            <VBox spacing="16" style="-fx-background-color: #f5f7fb;">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Metric:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="metricSelector" prefWidth="150"/>
                </HBox>
                <VBox fx:id="chartContainer" spacing="16" style="-fx-background-color: #f5f7fb;"/>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
